# Copy this file to ".env" and fill in your values. Never commit ".env".

# Your OpenRouter key, from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# "openrouter/free" picks any currently free model, or use a specific model id ending in :free
OPENROUTER_MODEL=openrouter/free

# Port the local server listens on
PORT=3000

# Max AI requests per IP address per minute
RATE_LIMIT_PER_MIN=20
