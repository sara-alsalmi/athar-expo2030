# Copy this file to ".env" and fill in your values. Never commit ".env".

# Your OpenRouter key, from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model id. Free ones end in :free. "openrouter/free" picks any free model, but it is slower and less reliable.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# "off" turns off the model's hidden thinking so replies are fast and complete. Use "on" to allow it.
OPENROUTER_REASONING=off

# Port the local server listens on
PORT=3000

# Max AI requests per IP address per minute
RATE_LIMIT_PER_MIN=20
